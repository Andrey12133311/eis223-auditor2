FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-accounts.txt /app/
RUN pip install --no-cache-dir -r requirements-accounts.txt
COPY scripts/ /app/scripts/
RUN python -m compileall -q /app/scripts
COPY tests/ /app/tests/
RUN python -m unittest discover -s tests -p 'test_account_*.py' -v
EXPOSE 8080
CMD ["python","-m","uvicorn","scripts.account_staging_app:application","--host","0.0.0.0","--port","8080"]
